{
  "name": "anpta dev",
  "image": "vhaasteren/anpta:cpu",
  "overrideCommand": false,
  "containerEnv": {
    "HOST_UID": "${localEnv:UID}",
    "HOST_GID": "${localEnv:GID}",
    "HOME_OVERRIDE": "/workspaces/${localWorkspaceFolderBasename}/.home",
    "PYTHONUSERBASE": "/workspaces/${localWorkspaceFolderBasename}/.home/.local",
    "PYTHONPYCACHEPREFIX": "/workspaces/${localWorkspaceFolderBasename}/.home/.cache/pycache"
  },
  "remoteUser": "anpta",
  "updateRemoteUserUID": false,
  "remoteEnv": {
    "HOME": "${containerEnv:HOME_OVERRIDE}",
    "VIRTUAL_ENV": "/opt/venvs/pta",
    "PATH": "/opt/julia/juliaup/bin:/opt/venvs/pta/bin:${containerEnv:PYTHONUSERBASE}/bin:${containerEnv:PATH}",
    "JULIA_PROJECT": "/opt/julia/project",
    "JULIA_DEPOT_PATH": "/opt/julia/depot",
    "PYTHON_JULIACALL_HANDLE_SIGNALS": "yes",
    "PYTHON_JULIACALL_EXE": "/opt/julia/juliaup/bin/julia",
    "PYTHON_JULIACALL_PROJECT": "/opt/julia/project",
    "JULIA_CONDAPKG_BACKEND": "Null",
    "PYTHON_JULIAPKG_OFFLINE": "true",
    "JULIA_NUM_THREADS": "auto",
    "PYTHON_JULIACALL_THREADS": "auto",
    "DISPLAY": ":0"
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "onCreateCommand": "mkdir -p \"$HOME\" && git config --global --add safe.directory \"$PWD\" || true && /opt/venvs/pta/bin/python -m ipykernel install --user --name=pta --display-name='Python (pta)'",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/venvs/pta/bin/python",
        "python.terminal.activateEnvironment": false,
        "jupyter.kernels.filter": [
          {
            "type": "pythonEnvironment",
            "path": "/opt/venvs/pta/bin/python"
          },
          {
            "type": "jupyterKernel",
            "value": "Julia (vela)"
          }
        ],
        "jupyter.kernelSpecRootPaths": [
          "/opt/venvs/pta/share/jupyter/kernels"
        ],
        "julia.executablePath": "/opt/julia/juliaup/bin/julia"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-python.vscode-pylance",
        "redhat.vscode-yaml",
        "eamodio.gitlens",
        "julialang.language-julia"
      ]
    }
  }
}
